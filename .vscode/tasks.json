{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary",
        "-c",
        "${input:config}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
        {
          "label": "Test: MTP Hot Reload",
          "type": "shell",
          "command": "dotnet",
          "args": [
            "run",
            "--project",
            "${input:testProject}"
          ],
          "options": {
            "env": {
              "TESTINGPLATFORM_HOTRELOAD_ENABLED": "1"
            }
          },
          "group": {
            "kind": "test",
            "isDefault": true
          },
          "presentation": {
            "reveal": "always",
            "panel": "dedicated",
            "clear": true
          },
          "problemMatcher": "$msCompile"
        }
  ],
  "inputs": [
    {
      // https://marketplace.visualstudio.com/items?itemName=rioj7.command-variable#pickstringremember
      "id": "config",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "key": "buildConfig",
        "addLabelToTop": "${remember:buildConfig}",
        "default": "Debug",
        // Directory names are case-sensitive in Linux.
        "options": [
          {
            "label": "Debug",
            "value": "Debug",
            "picked": true
          },
          {
            "label": "Release",
            "value": "release"
          }
        ],
        "description": "Build configuration"
      }
    },
    {
      "id": "testProject",
      "type": "command",
      "command": "extension.commandvariable.file.pickFile",
      "args": {
        "description": "Pick a test project.",
        "include": "**/tests/**/*.csproj",
        "acceptIfOneFile": true,
        "keyRemember": "testProject"
      }
    }
  ]
}
